# 1. Base image for IsaacLab-enabled setup.
FROM cobalt-simulators-isaaclab:latest

# Set default working directory
WORKDIR /app

# 2. Copy requirements first (for better caching)
COPY requirements-core.txt requirements-isaaclab.txt ./

# 3. Install Python dependencies using Isaac Sim's Python interpreter
RUN /isaac-sim/python.sh -m pip install -r requirements-core.txt && \
    /isaac-sim/python.sh -m pip install -r requirements-isaaclab.txt

# 4. Now copy your remaining source code
COPY . .

# 5. Install teleop server as an editable package
RUN /isaac-sim/python.sh -m pip install -e .

# 6. Environment variables for acceptance of licenses
ENV ACCEPT_EULA=Y
ENV PRIVACY_CONSENT=Y
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH="/workspace/LIBERO:/app"

# Need to do this to prevent interactive prompts during libero import
RUN echo "n" | /isaac-sim/python.sh -c "from libero.libero import get_libero_path; print('LIBERO environment primed.')"

# 7. Set default command to run your server in headless mode
ENTRYPOINT ["/isaac-sim/python.sh"]
CMD ["server/server.py", "--headless"]
